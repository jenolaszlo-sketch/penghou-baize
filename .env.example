# Opt-in live tests. Copy this file to .env.local and add your own key.
BAIZE_RUN_LIVE_TESTS=1
BAIZE_LIVE_PROVIDER=Gemini
BAIZE_LIVE_MODEL=gemini-3.6-flash
# Optional for compatible APIs, for example DeepSeek with the OpenAI client:
# BAIZE_LIVE_BASE_URL=https://api.deepseek.com/v1
# BAIZE_LIVE_SECRET_NAME=DEEPSEEK_API_KEY
# BAIZE_LIVE_DIALECT=DeepSeek
# DEEPSEEK_API_KEY=
GEMINI_API_KEY=
BAIZE_LIVE_TEST_TOOLS=1
BAIZE_LIVE_TEST_THINKING=0
BAIZE_LIVE_TEST_BATCH=0
BAIZE_LIVE_TEST_IMAGE_GENERATION=0
# Optional; the provider probe defaults to Gemini's cheapest current image model.
BAIZE_LIVE_IMAGE_MODEL=gemini-3.1-flash-lite-image
# Optional; live thinking and large media responses can exceed .NET's default.
BAIZE_LIVE_HTTP_TIMEOUT_SECONDS=300
