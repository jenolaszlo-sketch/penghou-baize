<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>

    <PackageId>Penghou.Baize.Router</PackageId>
    <Title>Penghou Baize Router</Title>
    <Version>0.1.0</Version>
    <Authors>Penghou.Baize contributors</Authors>
    <Description>Configuration-driven model routing and capability fallback over Penghou.Baize clients.</Description>
    <PackageTags>llm;chat;router;model-routing;capability;ai</PackageTags>
    <RepositoryUrl>https://github.com/jenolaszlo-sketch/penghou-baize</RepositoryUrl>
    <PackageProjectUrl>https://github.com/jenolaszlo-sketch/penghou-baize</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.9" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Penghou.Baize.Router.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Penghou.Baize.Claude\Penghou.Baize.Claude.csproj" />
    <ProjectReference Include="..\Penghou.Baize.Gemini\Penghou.Baize.Gemini.csproj" />
    <ProjectReference Include="..\Penghou.Baize.Ollama\Penghou.Baize.Ollama.csproj" />
    <ProjectReference Include="..\Penghou.Baize.OpenAi\Penghou.Baize.OpenAi.csproj" />
    <ProjectReference Include="..\Penghou.Baize\Penghou.Baize.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
